# Which provider runs Gemma 4: digitalocean | gemini | lmstudio | ollama
LLM_PROVIDER=digitalocean

# DigitalOcean Serverless Inference (Control panel -> Inference -> Model Access Keys)
MODEL_ACCESS_KEY=

# Google AI Studio / Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Local servers need no key. Change these only if they run elsewhere.
# LMSTUDIO_BASE_URL=http://localhost:1234/v1/
# OLLAMA_BASE_URL=http://localhost:11434/v1/

# Optional overrides (defaults depend on the provider):
#   digitalocean: gemma-4-31B-it, fallback openai-gpt-oss-120b
#   gemini:       gemma-4-26b-a4b-it, fallback gemma-4-31b-it
#   lmstudio:     google/gemma-4-e4b
#   ollama:       gemma4
# MODEL_ID=
# FALLBACK_PROVIDER=gemini        # e.g. run locally, fall back to the cloud
# FALLBACK_MODEL_ID=
# LLM_TIMEOUT=                    # seconds; defaults to 150 (cloud) or 400 (local)
